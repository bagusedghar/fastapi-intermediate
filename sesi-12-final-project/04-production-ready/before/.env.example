# Salin jadi .env, lalu isi nilainya. File .env tidak di-commit (ada di .gitignore).
# Jalankan API dengan: uvicorn app.main:app --reload --no-access-log --env-file .env

# development = /docs aktif, production = /docs mati
ENV=development

# Wajib, minimal 32 karakter. Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30

# Domain frontend yang boleh memanggil API dari browser, dipisah koma. Kosong = tidak ada.
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/orders
